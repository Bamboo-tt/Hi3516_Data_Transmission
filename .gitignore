# Local SDKs, toolchains, vendor reference packages and firmware collections.
/SDK/
/交叉编译工具链/
/工具/
/mirror/
/hi3516cv610/
/辅助文档/
*.zip
*.rar
*.7z
*.tgz
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz

# Private keys and local credentials. Never force-add these files.
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example
!.env.sample

# Object files, caches and local editor/OS files.
*.o
*.o.d
*.o.cmd
*.d
*.dep
*.pyc
__pycache__/
.cache/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
.vs/
.idea/
.vscode/
.DS_Store
Thumbs.db
~$*
*.log
*.tmp
*.swp

# Rebuildable RTSP archives. Keep prebuilt third-party libraries elsewhere.
/sample_source/*/rtsp_lib/librtsp.a

# OP-TEE TA build outputs listed by the sample Makefile clean target.
/sample_source/optee/security_subsys/ta/*.ta
/sample_source/optee/security_subsys/ta/*.dmp
/sample_source/optee/security_subsys/ta/*.elf
/sample_source/optee/security_subsys/ta/*.map
/sample_source/optee/security_subsys/ta/*.lds
/sample_source/optee/security_subsys/ta/dyn_list

# Board images and compiled drivers; retain PQ/model .bin files.
/hi3516firm/boot_image.bin
/hi3516firm/nand_env.bin
/hi3516firm/uImage
/hi3516firm/rtp_demo2
*.ubi
*.ubifs
*.ko

# Executables identified by ELF headers; do not ignore sample_*.c / *.h.
/sample_venc
/sample_source/airtsp/sample_airtsp
/sample_source/audio/sample_audio
/sample_source/awb_online_calibration/sample_awb_calibration
